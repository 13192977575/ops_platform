# ops_platform 生产环境变量模板
# 复制为 .env.production 并填写后:docker compose up -d
DJANGO_ENV=prod
# 生成:python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me
DJANGO_ALLOWED_HOSTS=ops.example.com
DJANGO_TIME_ZONE=Asia/Shanghai

POSTGRES_DB=ops_platform
POSTGRES_USER=ops
POSTGRES_PASSWORD=replace-me-strong
POSTGRES_HOST=db
POSTGRES_PORT=5432

# 与 docker-compose 中 redis 服务名一致
REDIS_URL=redis://redis:6379/0

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

LOG_LEVEL=INFO
LOG_RETENTION_DAYS=90

# 告警渠道凭据加密密钥(Fernet):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ALERT_ENCRYPTION_KEY=replace-me-fernet-key

# SMTP(告警邮件渠道)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_HOST_USER=ops@example.com
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=ops@example.com

# HTTPS 加固(默认关闭以支持裸 HTTP 直连;接入 nginx/caddy 做 TLS 后再改为 true)
# 注意:HTTP 模式下这三个必须都是 false,否则登录 cookie 不生效且所有请求被 301 到 https
SECURE_SSL_REDIRECT=false
CSRF_COOKIE_SECURE=false
SESSION_COOKIE_SECURE=false

# Web 对外端口(compose 映射为 WEB_PORT:8000)
WEB_PORT=8001
