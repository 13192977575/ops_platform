# 运行环境:dev | prod
DJANGO_ENV=dev
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Asia/Shanghai

# 数据库(dev 默认 SQLite 无需配置;prod 必须配置 PostgreSQL)
POSTGRES_DB=ops_platform
POSTGRES_USER=ops
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# 日志
LOG_LEVEL=INFO
